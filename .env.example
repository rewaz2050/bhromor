# =====================================================================
# PROSANTI — environment template (.env.example)
# ---------------------------------------------------------------------
# Copy to .env.local and fill in:
#     cp .env.example .env.local
# .env.local is git-ignored — never commit real keys.
#
# The app is live-only: the Supabase keys below power the catalog,
# checkout, admin, rider and tracking backends. Without them the
# storefront still paints the launch catalog, but every backend endpoint
# answers an honest 503/unavailable instead of running a demo.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (REQUIRED for the backend phase)
# Project Settings → API  →  copy these three values
# ---------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — safe for the browser (RLS still protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and
# never expose it in client code. Used for admin/seed operations that
# bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Cloudinary (product images + videos, §13–15, §48–49)
# Free account: https://cloudinary.com → Dashboard shows the Cloud name;
# API Key + API Secret live under Settings (gear icon) → API Keys.
# Full owner guide (Bangla): docs/media-setup.md
# ---------------------------------------------------------------------

# Cloud name is public (appears in media URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Signed-upload credentials — SERVER-ONLY (never NEXT_PUBLIC_)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------
# OPTIONAL — future phases only (leave blank for now)
# ---------------------------------------------------------------------

# Notifications channels (§35) — when SMS/WhatsApp go live
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# Courier API (blueprint §22) — third-party courier integration later
# PATHOA_BASE_URL=
# PATHOA_API_TOKEN=

# Optional hosted newsletter opt-in page (HTTPS). Overrides the built-in
# table-based footer signup when set (the hosted service then owns consent,
# unsubscribe and delivery). Leave blank to use the built-in list — free,
# no third party. Without Supabase keys, signup honestly shows "opening
# soon" and collects no emails.
NEWSLETTER_SIGNUP_URL=

# Public canonical origin used by /sitemap.xml and /robots.txt.
# No trailing slash. On Vercel the production URL is detected automatically;
# set this to pin it or when deploying elsewhere.
# NEXT_PUBLIC_SITE_URL=https://prosanti.store
